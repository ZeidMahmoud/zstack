#!/usr/bin/env bash
# zstack-relink — re-create skill symlinks based on skill_prefix config
#
# Usage:
#   zstack-relink
#
# Env overrides (for testing):
#   ZSTACK_STATE_DIR   — override ~/.zstack state directory
#   ZSTACK_INSTALL_DIR — override zstack install directory
#   ZSTACK_SKILLS_DIR  — override target skills directory
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ZSTACK_CONFIG="${SCRIPT_DIR}/zstack-config"

# Detect install dir
INSTALL_DIR="${ZSTACK_INSTALL_DIR:-}"
if [ -z "$INSTALL_DIR" ]; then
  if [ -d "$HOME/.claude/skills/zstack" ]; then
    INSTALL_DIR="$HOME/.claude/skills/zstack"
  elif [ -d "${SCRIPT_DIR}/.." ] && [ -f "${SCRIPT_DIR}/../setup" ]; then
    INSTALL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
  fi
fi

if [ -z "$INSTALL_DIR" ] || [ ! -d "$INSTALL_DIR" ]; then
  echo "Error: zstack install directory not found." >&2
  echo "Run: cd ~/.claude/skills/zstack && ./setup" >&2
  exit 1
fi

# Detect target skills dir
SKILLS_DIR="${ZSTACK_SKILLS_DIR:-$(dirname "$INSTALL_DIR")}"
[ -d "$SKILLS_DIR" ] || mkdir -p "$SKILLS_DIR"

# Read prefix setting
PREFIX=$("$ZSTACK_CONFIG" get skill_prefix 2>/dev/null || echo "false")

# #2569: rendered :user variants (brain-aware blocks) live in an UNTRACKED
# out-dir instead of the tracked install checkout. When a render exists for a
# skill, relink serves it — otherwise a config change would silently flip
# every skill back to the canonical (blockless) source.
RENDER_DIR="${ZSTACK_USER_RENDER_DIR:-${ZSTACK_HOME:-$HOME/.zstack}/render/claude}"

# Helper: remove old skill entry (symlink or real directory with symlinked SKILL.md)
# Only entries that resolve into this install (or its render dir) are ours to
# remove. A same-named entry owned by another skill suite installed side by
# side (e.g. gstack's flat /review next to our /zstack-review) is left alone;
# without this guard every prefixed setup run wiped the other suite's skills.
_owned_by_us() {
  local dest="$1"
  case "$dest" in
    "$INSTALL_DIR"/*|"$RENDER_DIR"/*|zstack/*|*/zstack/*|*/.zstack/render/claude/*) return 0 ;;
  esac
  return 1
}
_cleanup_skill_entry() {
  local entry="$1" dest
  if [ -L "$entry" ]; then
    dest="$(readlink "$entry" 2>/dev/null || true)"
    _owned_by_us "$dest" && rm -f "$entry"
  elif [ -d "$entry" ] && [ -L "$entry/SKILL.md" ]; then
    dest="$(readlink "$entry/SKILL.md" 2>/dev/null || true)"
    _owned_by_us "$dest" && rm -rf "$entry"
  fi
}

_link_root_skill_alias() {
  local target="$SKILLS_DIR/_zstack-command"

  [ -f "$INSTALL_DIR/SKILL.md" ] || return 0
  [ -L "$target" ] && rm -f "$target"
  mkdir -p "$target"
  # Copy-then-rewrite, never a symlink (#2511): a symlinked alias re-serves
  # the canonical `name: zstack`, Claude Code sees a duplicate skill name,
  # and drops the ENTIRE personal-skills set. sed reads the source and writes
  # a fresh copy — remove any prior symlink first so the redirect can never
  # write through it into the generated source.
  rm -f "$target/SKILL.md"
  sed "1,/^---\$/ s/^name:[[:space:]].*/name: _zstack-command/" "$INSTALL_DIR/SKILL.md" > "$target/SKILL.md"
}

_link_root_skill_alias

# Discover skills (directories with SKILL.md, excluding meta dirs)
SKILL_COUNT=0
for skill_dir in "$INSTALL_DIR"/*/; do
  [ -d "$skill_dir" ] || continue
  # Skip symlinked skill dirs (connect-chrome → open-zstack-browser): linking
  # one under the symlink's basename would duplicate the canonical frontmatter
  # name and collide in Claude Code's skill registry (#2201). setup owns the
  # rewritten-copy alias for those.
  [ -L "${skill_dir%/}" ] && continue
  skill=$(basename "$skill_dir")
  # Skip non-skill directories
  case "$skill" in bin|browse|design|docs|extension|lib|node_modules|scripts|test|.git|.github) continue ;; esac
  [ -f "$skill_dir/SKILL.md" ] || continue

  if [ "$PREFIX" = "true" ]; then
    # Don't double-prefix directories already named zstack-*
    case "$skill" in
      zstack-*) link_name="$skill" ;;
      *)        link_name="zstack-$skill" ;;
    esac
    # Remove old flat entry if it exists (and isn't the same as the new link)
    [ "$link_name" != "$skill" ] && _cleanup_skill_entry "$SKILLS_DIR/$skill"
  else
    link_name="$skill"
    # Don't remove zstack-* dirs that are their real name (e.g., zstack-upgrade)
    case "$skill" in
      zstack-*) ;; # Already the real name, no old prefixed link to clean
      *)        _cleanup_skill_entry "$SKILLS_DIR/zstack-$skill" ;;
    esac
  fi
  target="$SKILLS_DIR/$link_name"
  # Upgrade old directory symlinks to real directories
  [ -L "$target" ] && rm -f "$target"
  # Create real directory with symlinked SKILL.md (absolute path)
  mkdir -p "$target"
  skill_md_src="$INSTALL_DIR/$skill/SKILL.md"
  [ -f "$RENDER_DIR/$skill/SKILL.md" ] && skill_md_src="$RENDER_DIR/$skill/SKILL.md"
  ln -snf "$skill_md_src" "$target/SKILL.md"
  SKILL_COUNT=$((SKILL_COUNT + 1))
done

# Patch SKILL.md name: fields to match prefix setting. When a gbrain render
# is active the loop above links SKILL.md from RENDER_DIR — the file the host
# actually serves — so patch THAT tree too or skill_prefix=true is a no-op
# for every brain-aware skill (#2738). zstack-patch-names takes an arbitrary
# root, skips already-prefixed names (idempotent), and the render dir is
# user-owned and untracked, so patching it never dirties a checkout.
"$INSTALL_DIR/bin/zstack-patch-names" "$INSTALL_DIR" "$PREFIX"
[ -d "$RENDER_DIR" ] && "$INSTALL_DIR/bin/zstack-patch-names" "$RENDER_DIR" "$PREFIX"

if [ "$PREFIX" = "true" ]; then
  echo "Relinked $SKILL_COUNT skills as zstack-*"
else
  echo "Relinked $SKILL_COUNT skills as flat names"
fi
